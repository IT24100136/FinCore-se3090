          ]
        }
      },
      "response": []
    },
    {
      "name": "7. Analytics - Fetch Admin Device Metrics Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Summary metrics contains delivery success rate and device telemetry\", function () {",
              "    pm.expect(jsonData).to.have.property(\"deliverySuccessRate\");",
              "    pm.expect(jsonData).to.have.property(\"telemetry\");",
              "    pm.expect(jsonData.telemetry).to.have.property(\"totalDevices\");",
              "    pm.expect(jsonData.telemetry).to.have.property(\"verifiedDevices\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/devices/analytics/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "analytics",
            "summary"
          ]
        }
      },
      "response": []
    }
  ],
